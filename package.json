{
  "name": "agent-harness-academy",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check:content && npm test && npm run build",
    "sync:content": "node scripts/sync-content.mjs",
    "build:offline": "node scripts/build-standalone.mjs",
    "verify:local": "npm run build:offline && npm run check:content && npm test",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  }
}
